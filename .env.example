# --- CLERK AUTHENTICATION KEYS ---
# Dapatkan keys ini dari dashboard Clerk Anda (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- CONFIGURASI ROUTE CLERK (Opsional) ---
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin

# --- WEB PUSH NOTIFICATION (VAPID KEYS) ---
# Generate dengan: npx web-push generate-vapid-keys
# Simpan Public Key di NEXT_PUBLIC_ agar bisa diakses oleh browser (frontend)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
# Subject: email atau URL yang menjadi kontak VAPID (wajib diisi)
VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- SUPER ADMIN ---
# Clerk User ID yang akan menerima notifikasi push untuk semua toko.
# Bisa lebih dari satu, dipisah koma (tanpa spasi): user_abc123,user_def456
SUPER_ADMIN_USER_IDS=user_clerk_id_super_admin_here

# --- APP URL ---
# URL domain aplikasi (Gunakan http://localhost:3000 untuk local dev, https://www.pjtechumkm.com untuk production Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MAYAR.ID PAYMENT GATEWAY ---
MAYAR_WEBHOOK_SECRET=your_mayar_webhook_secret_here
MAYAR_API_KEY=your_mayar_api_key_here
MAYAR_BASE_URL=https://api.mayar.id/hl/v1
