generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model product {
  id                 Int       @id @default(autoincrement())
  userId             String // Identifikasi tenant (Clerk User ID)
  kodeBarang         String? // SKU/Barcode barang (opsional)
  name               String
  hpp                Int      @default(0) // Harga Pokok Penjualan (Modal) - untuk Retail/FNB/Rental/Sparepart
  biayaModal         Int      @default(0) // Biaya Modal/Bahan per pengerjaan - KHUSUS Jasa murni
  hargaJual          Int // Harga yang ditampilkan ke pelanggan (dulu price)
  category           String   @default("Umum")
  stock              Int      @default(0)
  discount           Int      @default(0) // Potongan harga bawaan produk
  image              String   @default("")
  brand              String?
  variant            String?
  minStockThreshold  Int      @default(5)
  isService          Boolean  @default(false)
  description        String?
  employeeCommission Int?     @default(0)
  isActive           Boolean  @default(true)
  isArchived         Boolean  @default(false)
  createdAt          DateTime @default(now()) // Harus ada baris ini!
  bookings           Booking[]

  // Memastikan kodeBarang bersifat unik di dalam satu tenant (userId)
  @@unique([userId, kodeBarang])
  @@index([userId])
  @@index([category])
}

model Transaction {
  id           String            @id
  userId       String // Identifikasi tenant
  timestamp    BigInt
  customerName String
  cashierId    String?
  cashier      Employee?         @relation("CashierTransactions", fields: [cashierId], references: [id])
  tableId      String?
  table        DiningTable?      @relation(fields: [tableId], references: [id])
  discount     Int               @default(0) // Potongan harga oleh kasir
  total        Int
  method       String
  status       String            @default("pending")
  createdAt    DateTime          @default(now())
  // === Rental & Travel fields ===
  startDate    DateTime?
  endDate      DateTime?
  pickupLocation String?
  dropoffLocation String?
  driverName   String?
  licensePlate String?
  serviceDate  DateTime?
  guarantee    String?
  downPayment  Int               @default(0)
  remainingBalance Int           @default(0)
  items        TransactionItem[]

  @@index([userId, createdAt])
  @@index([userId, createdAt, cashierId]) // Optimasi query laporan shift per kasir
  @@index([status])
}

model TransactionItem {
  id                 Int         @id @default(autoincrement())
  transactionId      String
  transaction        Transaction @relation(fields: [transactionId], references: [id])
  productId          Int
  qty                Int
  price              Int // Harga barang pada saat transaksi terjadi
  note               String?
  workerId           String?
  worker             Employee?   @relation("WorkerItems", fields: [workerId], references: [id])
  serviceDuration    Int?        @default(0)
  commissionSnapshot Int         @default(0) // Snapshot komisi pada saat transaksi terjadi

  @@index([transactionId])
  @@index([productId])
  @@index([workerId])
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  title     String
  amount    Int
  category  String
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Tenant {
  id                 String    @id @default(cuid())
  userId             String    @unique
  name               String
  category           String
  slug               String?   @unique
  phone              String?   @default("")
  subscriptionPlan   String    @default("FREE")
  subscriptionStatus String    @default("ACTIVE")
  subscriptionEndsAt DateTime?
  createdAt          DateTime  @default(now())
  bookings           Booking[]
  
  // === Payment & Contact Info ===
  adminWhatsApp      String?
  bankName           String?
  bankAccount        String?
  bankAccountName    String?

  // === Booking Schedule Settings (Khusus Jasa / Servis) ===
  bookingOpenTime    String?   @default("08:00")
  bookingCloseTime   String?   @default("21:00")
  bookingSlotDuration Int?     @default(30)

  @@index([subscriptionStatus])
  @@index([slug])
}

model Employee {
  id                  String            @id @default(cuid())
  clerkUserId         String            @unique
  tenantId            String
  name                String
  email               String
  createdAt           DateTime          @default(now())
  cashierTransactions Transaction[]     @relation("CashierTransactions")
  workerItems         TransactionItem[] @relation("WorkerItems")

  @@index([tenantId])
}

model DiningTable {
  id           String        @id @default(cuid())
  userId       String
  name         String
  capacity     Int           @default(4)
  status       String        @default("Tersedia")
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  details   Json
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

enum BookingStatus {
  PENDING
  COMPLETED
  IN_PROGRESS
  CANCELLED
  FINISHED
}

model Booking {
  id            String        @id @default(uuid())
  userId        String        // Identifikasi tenant (Multi-Tenant Isolation)
  tenant        Tenant        @relation(fields: [userId], references: [userId])
  customerName  String
  customerPhone String
  bookingDate   DateTime
  notes         String?
  status        BookingStatus @default(PENDING)
  productId     Int?
  product       product?      @relation(fields: [productId], references: [id])
  // === Rental & Travel fields ===
  startDate     DateTime?
  endDate       DateTime?
  pickupLocation String?
  dropoffLocation String?
  // === Equipment/Alat fields ===
  returnTime    String?
  deposit       Int           @default(0)
  conditionNotes String?
  actualStartedAt DateTime?
  overtimeFee   Int           @default(0)
  downPayment   Int           @default(0)
  paymentMethod String?       // e.g. "CASH", "TUNAI", "QRIS"
  createdAt     DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String   // Clerk User ID (Owner atau Super Admin)
  createdAt DateTime @default(now())

  @@index([userId])
}
