generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model product {
  id                 Int       @id @default(autoincrement())
  userId             String
  kodeBarang         String?
  name               String
  hpp                Int       @default(0)
  hargaJual          Int
  category           String    @default("Umum")
  stock              Int       @default(0)
  discount           Int       @default(0)
  image              String    @default("")
  brand              String?
  variant            String?
  minStockThreshold  Int       @default(5)
  isService          Boolean   @default(false)
  description        String?
  employeeCommission Int?      @default(0)
  isActive           Boolean   @default(true)
  isArchived         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  biayaModal         Int       @default(0)
  bookings           Booking[]

  @@unique([userId, kodeBarang])
  @@index([userId])
  @@index([category])
}

model Transaction {
  id               String            @id
  userId           String
  timestamp        BigInt
  customerName     String
  customerPhone    String?
  cashierId        String?
  tableId          String?
  discount         Int               @default(0)
  total            Int
  method           String
  status           String            @default("pending")
  createdAt        DateTime          @default(now())
  startDate        DateTime?
  endDate          DateTime?
  pickupLocation   String?
  dropoffLocation  String?
  driverName       String?
  licensePlate     String?
  serviceDate      DateTime?
  guarantee        String?
  downPayment      Int               @default(0)
  remainingBalance Int               @default(0)
  conditionNotes   String?
  deposit          Int               @default(0)
  pickupTime       String?
  returnTime       String?
  cashier          Employee?         @relation("CashierTransactions", fields: [cashierId], references: [id])
  table            DiningTable?      @relation(fields: [tableId], references: [id])
  items            TransactionItem[]

  @@index([userId, createdAt])
  @@index([userId, createdAt, cashierId])
  @@index([status])
}

model TransactionItem {
  id                 Int         @id @default(autoincrement())
  transactionId      String
  productId          Int
  qty                Int
  price              Int
  note               String?
  workerId           String?
  serviceDuration    Int?        @default(0)
  commissionSnapshot Int         @default(0)
  transaction        Transaction @relation(fields: [transactionId], references: [id])
  worker             Employee?   @relation("WorkerItems", fields: [workerId], references: [id])

  @@index([transactionId])
  @@index([productId])
  @@index([workerId])
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  title     String
  amount    Int
  category  String
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Tenant {
  id                  String    @id @default(cuid())
  userId              String    @unique
  name                String
  category            String
  slug                String?   @unique
  phone               String?   @default("")
  subscriptionPlan    String    @default("FREE")
  subscriptionStatus  String    @default("ACTIVE")
  subscriptionEndsAt  DateTime?
  createdAt           DateTime  @default(now())
  adminWhatsApp       String?
  bankName            String?
  bankAccount         String?
  bankAccountName     String?
  bookingCloseTime    String?   @default("21:00")
  bookingOpenTime     String?   @default("08:00")
  bookingSlotDuration Int?      @default(30)
  bookings            Booking[]

  @@index([subscriptionStatus])
  @@index([slug])
}

model Employee {
  id                  String            @id @default(cuid())
  clerkUserId         String            @unique
  tenantId            String
  name                String
  email               String
  createdAt           DateTime          @default(now())
  cashierTransactions Transaction[]     @relation("CashierTransactions")
  workerItems         TransactionItem[] @relation("WorkerItems")

  @@index([tenantId])
}

model DiningTable {
  id           String        @id @default(cuid())
  userId       String
  name         String
  capacity     Int           @default(4)
  status       String        @default("Tersedia")
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  details   Json
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model Booking {
  id              String        @id @default(uuid())
  userId          String
  customerName    String
  customerPhone   String
  bookingDate     DateTime
  notes           String?
  status          BookingStatus @default(PENDING)
  productId       Int?
  startDate       DateTime?
  endDate         DateTime?
  pickupLocation  String?
  dropoffLocation String?
  actualStartedAt DateTime?
  overtimeFee     Int           @default(0)
  downPayment     Int           @default(0)
  paymentMethod   String?
  createdAt       DateTime      @default(now())
  conditionNotes  String?
  deposit         Int           @default(0)
  pickupTime      String?
  returnTime      String?
  product         product?      @relation(fields: [productId], references: [id])
  tenant          Tenant        @relation(fields: [userId], references: [userId])

  @@index([userId, createdAt])
  @@index([status])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
}

enum BookingStatus {
  PENDING
  COMPLETED
  IN_PROGRESS
  CANCELLED
  FINISHED
}
